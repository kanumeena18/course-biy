# ==============================================================================
# COURSE BAZAR - CONFIGURATION ENVIRONMENT VARIABLES
# ==============================================================================
# Copy this file to .env and fill in your actual values:
# Windows PowerShell: Copy-Item .env.example .env
# Windows CMD:        copy .env.example .env
# Mac/Linux:          cp .env.example .env
#
# IMPORTANT: NEVER commit your actual .env file or private keys to GitHub!
# ==============================================================================

# 1. TELEGRAM BOT TOKEN (From @BotFather on Telegram)
# Example: 1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ
BOT_TOKEN=

# 2. GOOGLE SPREADSHEET ID
# Found in your Google Sheet URL between /d/ and /edit
# Example URL: https://docs.google.com/spreadsheets/d/1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgvE2upms/edit
# Sheet ID would be: 1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgvE2upms
GOOGLE_SHEET_ID=

# 3. GOOGLE CLOUD SERVICE ACCOUNT EMAIL
# Created in Google Cloud Console -> IAM & Admin -> Service Accounts
# Example: course-bazar-sheets@my-project-123456.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# 4. GOOGLE CLOUD PRIVATE KEY
# Found inside the downloaded JSON key file under "private_key"
# Keep quotes around it and keep the \n line breaks intact
# Example: "-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
GOOGLE_PRIVATE_KEY=

# 5. ADMIN TELEGRAM NUMERIC ID
# Your personal Telegram numeric user ID (Get it from @userinfobot on Telegram)
# Example: 123456789
ADMIN_TELEGRAM_ID=

# 6. UPI PAYMENT SETTINGS (Your personal UPI - No payment gateway)
# Your actual UPI ID where customers should pay
# Example: yourname@okaxis, yourname@upi, 9876543210@paytm
UPI_ID=example@upi

# Name shown to customers for UPI payee
PAYEE_NAME=Course Bazar

# 7. CUSTOMER SUPPORT USERNAME
# Telegram handle for customer support inquiries
# Example: @coursebazar_support
SUPPORT_USERNAME=@coursebazar_support

# 8. UPI QR CODE IMAGE PATH
# Path to your personal QR code image on your computer
# Default location: assets/qr-code.png
QR_IMAGE_PATH=./assets/qr-code.png

# 9. PAYMENT EXPIRY (in hours)
# If a customer clicks Buy Now but never submits a screenshot within this time
PAYMENT_EXPIRY_HOURS=24

# 10. STORE BRANDING
STORE_NAME=Course Bazar
CURRENCY=₹
PORT=3000
